# ArxivRAG Environment Configuration

# HuggingFace token (required for embedding model)
# https://huggingface.co/settings/tokens
HF_TOKEN=

# DeepSeek API (required for query answering)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=

# Query expansion (local vLLM, optional - falls back to original query if unavailable)
QUERY_EXPANSION_BASE_URL=http://localhost:8001/v1
QUERY_EXPANSION_MODEL=Qwen/Qwen2.5-3B-Instruct
